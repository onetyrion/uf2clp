---
import { CONSENT_EVENT, CONSENT_KEY, type ConsentValue } from '../../lib/consent';
---

<div
	id="consent-banner"
	role="region"
	aria-label="Consentimiento de cookies"
	class="hidden fixed inset-x-4 bottom-4 z-50 mx-auto max-w-3xl rounded-2xl border border-white/10 bg-slate-900/95 p-5 text-sm text-slate-300 shadow-2xl backdrop-blur-md"
>
	<div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
		<p class="leading-relaxed">
			Usamos cookies de análisis (Google Analytics y Microsoft Clarity) para entender cómo se usa el sitio.
			Puedes aceptarlas o rechazarlas.
			<a
				href="https://www.iubenda.com/privacy-policy/67905716/cookie-policy"
				target="_blank"
				rel="noopener noreferrer"
				class="underline hover:text-blue-400 transition-colors"
			>Política de Cookies</a>
		</p>
		<div class="flex shrink-0 gap-3">
			<button
				type="button"
				data-consent="denied"
				class="rounded-xl border border-slate-700 px-4 py-2 font-semibold text-slate-200 hover:border-slate-500 transition-colors"
			>Rechazar</button>
			<button
				type="button"
				data-consent="granted"
				class="rounded-xl bg-blue-600 px-4 py-2 font-semibold text-white hover:bg-blue-500 transition-colors"
			>Aceptar</button>
		</div>
	</div>
</div>

<script>
	import { CONSENT_EVENT, CONSENT_KEY, type ConsentValue } from '../../lib/consent';

	const banner = document.getElementById('consent-banner');

	let stored: string | null = null;
	try {
		stored = localStorage.getItem(CONSENT_KEY);
	} catch {
		stored = null;
	}

	if (banner) {
		if (!stored) {
			banner.classList.remove('hidden');
		}

		banner.querySelectorAll<HTMLButtonElement>('[data-consent]').forEach((button) => {
			button.addEventListener('click', () => {
				const value: ConsentValue = button.dataset.consent === 'granted' ? 'granted' : 'denied';
				try {
					localStorage.setItem(CONSENT_KEY, value);
				} catch {
					// Si no se puede persistir, igual aplicamos la decisión en esta visita.
				}
				window.dispatchEvent(new CustomEvent<ConsentValue>(CONSENT_EVENT, { detail: value }));
				banner.classList.add('hidden');
			});
		});
	}
</script>
