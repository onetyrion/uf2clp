---
import { formatClp, formatPercent, formatUsd } from '../../lib/format';
import { formatMonthYear, formatNumericDate } from '../../lib/date';
import type { IndicatorMeta } from '../../data/indicators';
import type { IndicatorQuote } from '../../lib/indicators';

interface Props {
	meta: IndicatorMeta;
	quote: IndicatorQuote | null;
	href: string;
}

const { meta, quote, href } = Astro.props;
const isExternal = href.startsWith('http');
const value = quote
	? meta.valueUnit === 'percent'
		? formatPercent(quote.valor)
		: meta.valueUnit === 'USD'
			? formatUsd(quote.valor)
			: formatClp(quote.valor)
	: 'No disponible';
const date = quote
	? meta.frequency === 'monthly'
		? formatMonthYear(quote.fecha)
		: formatNumericDate(quote.fecha)
	: null;
---

<a
	href={href}
	target={isExternal ? '_blank' : undefined}
	rel={isExternal ? 'noopener noreferrer' : undefined}
	class="group block rounded-2xl border border-slate-800 bg-slate-900/50 p-6 hover:border-blue-500/50 transition-colors"
>
	<div class="flex items-start justify-between gap-3">
		<div>
			<p class="text-xs font-semibold uppercase tracking-wider text-slate-400">{meta.name}</p>
			<p class="mt-2 text-3xl font-extrabold text-white tabular-nums">{value}</p>
		</div>
		<span class="rounded-full border border-slate-700 px-2 py-1 text-[10px] font-semibold uppercase tracking-wider text-slate-400">
			{meta.frequency === 'monthly' ? 'Mensual' : 'Diario'}
		</span>
	</div>
	<p class="mt-3 text-sm leading-relaxed text-slate-400">{meta.description}</p>
	{date && (
		<p class="mt-3 text-xs text-slate-500">
			Actualizado: {date} · Fuente: {meta.source}
		</p>
	)}
	<p class="mt-4 text-sm font-semibold text-blue-400">
		{isExternal ? 'Ver fuente oficial ↗' : 'Ver calculadora e historial →'}
	</p>
</a>
