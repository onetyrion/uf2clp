---
import Layout from '../../layouts/Layout.astro';
import { Card } from '../../components/atoms/Card';
import IndicatorCard from '../../components/molecules/IndicatorCard.astro';
import { fetchIndicator } from '../../lib/indicators';
import { INDICATORS } from '../../data/indicators';

const slugs = ['utm', 'dolar', 'tpm', 'tasa_desempleo', 'imacec', 'libra_cobre'] as const;

const quotes = await Promise.all(
	slugs.map(async (slug) => ({ slug, quote: await fetchIndicator(slug) })),
);

const detailPages: Record<string, string> = {
	utm: '/utm',
	dolar: '/dolar',
};

const breadcrumb = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://uf2clp.cl/' },
		{ '@type': 'ListItem', position: 2, name: 'Indicadores económicos', item: 'https://uf2clp.cl/indicadores/' },
	],
};

const collection = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: 'Indicadores económicos de Chile',
	url: 'https://uf2clp.cl/indicadores/',
	description: 'Valores vigentes de UTM, dólar observado, TPM, desempleo, Imacec y libra de cobre.',
	mainEntity: {
		'@type': 'ItemList',
		numberOfItems: 2,
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'UTM a pesos', url: 'https://uf2clp.cl/utm/' },
			{ '@type': 'ListItem', position: 2, name: 'Dólar a pesos', url: 'https://uf2clp.cl/dolar/' },
		],
	},
};
---

<Layout
	title="Indicadores Económicos de Chile | UTM, Dólar, TPM e Imacec"
	description="Valores vigentes de los principales indicadores económicos de Chile: UTM, dólar observado, TPM, tasa de desempleo, Imacec y libra de cobre."
	jsonLd={[breadcrumb, collection]}
>
	<main class="max-w-5xl mx-auto px-6 pt-10 pb-20 space-y-10 text-slate-400">
		<nav class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
			<a href="/" class="font-semibold text-slate-300 hover:text-blue-400 transition-colors">Inicio</a>
			<a href="/uf" class="font-semibold text-slate-300 hover:text-blue-400 transition-colors">Historial UF</a>
			<a href="/utm" class="font-semibold text-slate-300 hover:text-blue-400 transition-colors">UTM</a>
			<a href="/dolar" class="font-semibold text-slate-300 hover:text-blue-400 transition-colors">Dólar</a>
			<span class="font-semibold text-slate-400">Indicadores</span>
		</nav>

		<header class="space-y-3">
			<h1 class="text-3xl md:text-4xl font-extrabold text-white tracking-tight">Indicadores económicos de Chile</h1>
			<p class="leading-relaxed max-w-3xl">
				Valores vigentes de los principales indicadores publicados por el Banco Central de Chile, el SII y el INE.
				Haz clic en UTM o dólar para usar las calculadoras y ver el historial.
			</p>
		</header>

		<section aria-label="Indicadores" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
			{quotes.map(({ slug, quote }) => (
				<IndicatorCard
					meta={INDICATORS[slug]}
					quote={quote}
					href={detailPages[slug] ?? INDICATORS[slug].sourceUrl}
				/>
			))}
		</section>

		<Card className="p-6 bg-slate-900/50 border-slate-800">
			<h2 class="text-xl font-bold text-white mb-2">Sobre estos valores</h2>
			<p class="leading-relaxed">
				La UTM y el dólar observado tienen páginas propias con calculadora e historial por año. La TPM, la tasa
				de desempleo, el Imacec y la libra de cobre se muestran con su último valor publicado.
			</p>
			<p class="mt-3 text-sm text-slate-400">
				Fuentes: Banco Central de Chile, SII e INE, replicadas por
				<a href="https://mindicador.cl" target="_blank" rel="noopener noreferrer" class="underline hover:text-blue-400 transition-colors">mindicador.cl</a>.
				Los valores se actualizan con cada compilación del sitio.
			</p>
		</Card>

		<section aria-labelledby="indicadores-navegacion" class="space-y-4">
			<h2 id="indicadores-navegacion" class="text-xl font-bold text-white">Seguir navegando</h2>
			<div class="flex flex-wrap gap-3">
				<a href="/#calculadora" class="px-4 py-2 rounded-xl text-sm font-semibold text-slate-200 bg-slate-900/50 border border-slate-800 hover:border-blue-500/50 hover:text-blue-400 transition-colors">
					Convertir UF a pesos
				</a>
				<a href="/uf" class="px-4 py-2 rounded-xl text-sm font-semibold text-slate-200 bg-slate-900/50 border border-slate-800 hover:border-blue-500/50 hover:text-blue-400 transition-colors">
					Historial UF
				</a>
				<a href="/uf/manana" class="px-4 py-2 rounded-xl text-sm font-semibold text-slate-200 bg-slate-900/50 border border-slate-800 hover:border-blue-500/50 hover:text-blue-400 transition-colors">
					UF mañana
				</a>
			</div>
		</section>
	</main>
</Layout>
