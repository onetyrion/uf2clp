---
import Layout from '../../layouts/Layout.astro';
import { Card } from '../../components/atoms/Card';
import { fetchUFYear } from '../../lib/uf';
import { formatUfDate, getTodayISO } from '../../lib/date';
import { UF_CURRENT_YEAR, UF_YEARS, getMonthName, getMonthSlug } from '../../data/uf-years';
import type { UFData } from '../../services/api';

export async function getStaticPaths() {
	const today = getTodayISO();

	return Promise.all(
		UF_YEARS.map(async (year) => {
			const serie = await fetchUFYear(year);
			const data =
				serie && year === UF_CURRENT_YEAR
					? serie.filter((item) => item.fecha.slice(0, 10) <= today)
					: serie;

			return {
				params: { year: String(year) },
				props: { data },
			};
		}),
	);
}

interface Props {
	data: UFData[] | null;
}

const year = Number(Astro.params.year);
const { data } = Astro.props;
const otherYears = UF_YEARS.filter((item) => item !== year);
const latest = data?.[0] ?? null;
const oldest = data && data.length > 0 ? data[data.length - 1] : null;
const min = data && data.length > 0 ? data.reduce((a, b) => (b.valor < a.valor ? b : a)) : null;
const max = data && data.length > 0 ? data.reduce((a, b) => (b.valor > a.valor ? b : a)) : null;

const months = data && year === UF_CURRENT_YEAR
	? Array.from(new Set(data.map((item) => Number(item.fecha.slice(5, 7))))).sort((a, b) => a - b)
	: [];

const stats = [
	{ label: 'Valor más reciente', item: latest },
	{ label: 'Valor más antiguo', item: oldest },
	{ label: 'Mínimo del año', item: min },
	{ label: 'Máximo del año', item: max },
].filter((stat) => stat.item !== null);

const clpFormatter = new Intl.NumberFormat('es-CL', {
	style: 'currency',
	currency: 'CLP',
	minimumFractionDigits: 2,
	maximumFractionDigits: 2,
});
const formatValue = (value: number) => clpFormatter.format(value);

const breadcrumb = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://uf2clp.cl/' },
		{ '@type': 'ListItem', position: 2, name: 'Historial UF', item: 'https://uf2clp.cl/uf/' },
		{ '@type': 'ListItem', position: 3, name: `UF ${year}`, item: `https://uf2clp.cl/uf/${year}/` },
	],
};

const dataset = {
	'@context': 'https://schema.org',
	'@type': 'Dataset',
	name: `Valor de la UF en ${year}`,
	description: `Serie diaria del valor de la UF en Chile durante ${year}.`,
	url: `https://uf2clp.cl/uf/${year}/`,
	temporalCoverage: `${year}-01-01/${year}-12-31`,
	isAccessibleForFree: true,
	creator: {
		'@type': 'Organization',
		name: 'UF2CLP',
		url: 'https://uf2clp.cl/',
	},
	variableMeasured: 'Valor de la Unidad de Fomento (CLP)',
};
---

<Layout
	title={`Valor UF ${year} | Historial y tabla de valores`}
	description={`Historial del valor de la UF en ${year}: tabla diaria, valor mínimo y máximo, y resumen de la serie.`}
	jsonLd={[breadcrumb, dataset]}
>
	<main class="max-w-4xl mx-auto px-6 pt-10 pb-20 space-y-8 text-slate-400">
		<nav class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
			<a href="/" class="font-semibold text-slate-300 hover:text-blue-400 transition-colors">Inicio</a>
			<a href="/uf" class="font-semibold text-slate-300 hover:text-blue-400 transition-colors">Historial</a>
			<a href="/uf/manana" class="font-semibold text-slate-300 hover:text-blue-400 transition-colors">UF mañana</a>
			<a href="/#calculadora" class="font-semibold text-slate-300 hover:text-blue-400 transition-colors">Calculadora</a>
		</nav>

		<header class="space-y-3">
			<h1 class="text-3xl md:text-4xl font-extrabold text-white tracking-tight">
				Valor de la UF en {year}
			</h1>
			<p class="leading-relaxed max-w-3xl">
				Serie diaria de la Unidad de Fomento en Chile para {year}. Los valores se muestran del más reciente al más antiguo.
			</p>
		</header>

		{data && data.length > 0 ? (
			<>
				<section aria-label="Resumen del año" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
					{stats.map((stat) => (
						<Card className="p-5 bg-slate-900/50 border-slate-800">
							<p class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">{stat.label}</p>
							{stat.item && (
								<>
									<p class="text-xl font-bold text-white tabular-nums">{formatValue(stat.item.valor)}</p>
									<p class="text-xs text-slate-400 mt-1 capitalize">{formatUfDate(stat.item.fecha)}</p>
								</>
							)}
						</Card>
					))}
				</section>

				{months.length > 0 && (
					<section aria-labelledby="meses" class="space-y-4">
						<h2 id="meses" class="text-xl font-bold text-white">Meses de {year}</h2>
						<div class="flex flex-wrap gap-3">
							{months.map((month) => (
								<a
									href={`/uf/${year}/${getMonthSlug(month)}`}
									class="px-4 py-2 rounded-xl text-sm font-semibold text-slate-200 bg-slate-900/50 border border-slate-800 hover:border-blue-500/50 hover:text-blue-400 transition-colors capitalize"
								>
									{getMonthName(month)}
								</a>
							))}
						</div>
					</section>
				)}

				<section aria-labelledby="tabla-uf">
					<Card className="p-4 md:p-6 bg-slate-900/50 border-slate-800">
						<h2 id="tabla-uf" class="text-xl font-bold text-white mb-4 px-2">Tabla de valores</h2>
						<div class="overflow-x-auto">
							<table class="w-full text-sm text-left border-collapse">
								<thead>
									<tr class="text-slate-300 border-b border-white/10">
										<th scope="col" class="py-3 px-2 font-semibold">Fecha</th>
										<th scope="col" class="py-3 px-2 font-semibold text-right">Valor UF</th>
									</tr>
								</thead>
								<tbody>
									{data.map((item) => (
										<tr class="border-b border-white/5 hover:bg-white/5 transition-colors">
											<td class="py-2.5 px-2 text-slate-300 capitalize">
												<time datetime={item.fecha.slice(0, 10)}>{formatUfDate(item.fecha)}</time>
											</td>
											<td class="py-2.5 px-2 text-right font-medium text-white tabular-nums">
												{formatValue(item.valor)}
											</td>
										</tr>
									))}
								</tbody>
							</table>
						</div>
					</Card>
				</section>
			</>
		) : (
			<Card className="p-6 bg-slate-900/50 border-slate-800">
				<p class="text-slate-300">
					No fue posible cargar el historial de la UF para {year}. Intenta nuevamente más tarde.
				</p>
			</Card>
		)}

		<Card className="p-6 bg-slate-900/50 border-slate-800">
			<h2 class="text-xl font-bold text-white mb-2">¿Cómo se calcula el valor de la UF?</h2>
			<p class="leading-relaxed">
				La UF se reajusta diariamente según la variación del IPC del mes anterior. El Banco Central de Chile
				publica la tabla del mes con anticipación, por lo que cada día del calendario tiene un valor definido.
			</p>
			<p class="mt-3 text-sm text-slate-400">
				Fuente: Banco Central de Chile, replicada por
				<a href="https://mindicador.cl/uf" target="_blank" rel="noopener noreferrer" class="underline hover:text-blue-400 transition-colors">mindicador.cl</a>.
			</p>
		</Card>

		<section aria-labelledby="otros-anos" class="space-y-4">
			<h2 id="otros-anos" class="text-xl font-bold text-white">Otros años</h2>
			<div class="flex flex-wrap gap-3">
				{otherYears.map((item) => (
					<a
						href={`/uf/${item}`}
						class="px-4 py-2 rounded-xl text-sm font-semibold text-slate-200 bg-slate-900/50 border border-slate-800 hover:border-blue-500/50 hover:text-blue-400 transition-colors"
					>
						UF {item}
					</a>
				))}
				<a
					href="/uf"
					class="px-4 py-2 rounded-xl text-sm font-semibold text-slate-200 bg-slate-900/50 border border-slate-800 hover:border-blue-500/50 hover:text-blue-400 transition-colors"
				>
					Ver historial completo
				</a>
				<a
					href="/#calculadora"
					class="px-4 py-2 rounded-xl text-sm font-semibold text-slate-200 bg-slate-900/50 border border-slate-800 hover:border-blue-500/50 hover:text-blue-400 transition-colors"
				>
					Calculadora
				</a>
				<a
					href="/uf/manana"
					class="px-4 py-2 rounded-xl text-sm font-semibold text-slate-200 bg-slate-900/50 border border-slate-800 hover:border-blue-500/50 hover:text-blue-400 transition-colors"
				>
					UF mañana
				</a>
				<a
					href="/"
					class="px-4 py-2 rounded-xl text-sm font-semibold text-slate-200 bg-slate-900/50 border border-slate-800 hover:border-blue-500/50 hover:text-blue-400 transition-colors"
				>
					Inicio
				</a>
			</div>
		</section>
	</main>
</Layout>
