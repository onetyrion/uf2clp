---
import Layout from '../../layouts/Layout.astro';
import { Card } from '../../components/atoms/Card';
import { fetchCurrentUF } from '../../lib/uf';
import { formatUfDate } from '../../lib/date';
import { UF_YEARS } from '../../data/uf-years';

const current = await fetchCurrentUF();

const clpFormatter = new Intl.NumberFormat('es-CL', {
	style: 'currency',
	currency: 'CLP',
	minimumFractionDigits: 2,
	maximumFractionDigits: 2,
});

const breadcrumb = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://uf2clp.cl/' },
		{ '@type': 'ListItem', position: 2, name: 'Historial UF', item: 'https://uf2clp.cl/uf/' },
	],
};

const collection = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: 'Historial del valor de la UF en Chile',
	url: 'https://uf2clp.cl/uf/',
	description: 'Tablas diarias del valor de la UF por año y por mes.',
	mainEntity: {
		'@type': 'ItemList',
		numberOfItems: UF_YEARS.length,
		itemListElement: UF_YEARS.map((year, index) => ({
			'@type': 'ListItem',
			position: index + 1,
			name: `UF ${year}`,
			url: `https://uf2clp.cl/uf/${year}/`,
		})),
	},
};
---

<Layout
	title="Historial del valor de la UF en Chile | UF por año"
	description="Historial completo del valor de la UF en Chile: tablas diarias por año y por mes, valores mínimos y máximos, y el valor publicado para mañana."
	jsonLd={[breadcrumb, collection]}
>
	<main class="max-w-4xl mx-auto px-6 pt-10 pb-20 space-y-10 text-slate-400">
		<nav class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
			<a href="/" class="font-semibold text-slate-300 hover:text-blue-400 transition-colors">Inicio</a>
			<span class="text-slate-600">/</span>
			<span class="font-semibold text-slate-400">Historial</span>
		</nav>

		<header class="space-y-3">
			<h1 class="text-3xl md:text-4xl font-extrabold text-white tracking-tight">
				Historial de la UF por año
			</h1>
			<p class="leading-relaxed max-w-3xl">
				Consulta la tabla diaria del valor de la Unidad de Fomento en Chile para cada año, con el resumen de
				valores mínimos y máximos. También puedes revisar el valor publicado para mañana.
			</p>
		</header>

		{current && (
			<Card className="p-6 bg-slate-900/50 border-slate-800">
				<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
					<div>
						<p class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">Valor UF hoy</p>
						<p class="text-3xl font-extrabold text-white tabular-nums">{clpFormatter.format(current.valor)}</p>
						<p class="text-sm text-slate-400 mt-1 capitalize">{formatUfDate(current.fecha)}</p>
					</div>
					<a
						href="/"
						class="inline-flex px-4 py-2 rounded-xl text-sm font-semibold text-white bg-blue-600 hover:bg-blue-500 transition-colors"
					>
						Convertir UF a pesos
					</a>
				</div>
			</Card>
		)}

		<section aria-labelledby="anos" class="space-y-4">
			<h2 id="anos" class="text-xl font-bold text-white">Elige un año</h2>
			<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
				{UF_YEARS.map((year) => (
					<a
						href={`/uf/${year}`}
						class="group rounded-2xl border border-slate-800 bg-slate-900/50 p-5 hover:border-blue-500/50 transition-colors"
					>
						<span class="block text-2xl font-extrabold text-white group-hover:text-blue-400 transition-colors">UF {year}</span>
						<span class="mt-1 block text-xs uppercase tracking-wider text-slate-400">Tabla diaria</span>
					</a>
				))}
			</div>
		</section>

		<section aria-labelledby="manana" class="space-y-3">
			<h2 id="manana" class="text-xl font-bold text-white">Valor de la UF mañana</h2>
			<p class="leading-relaxed">
				El Banco Central publica el valor con anticipación. Revisa el monto que regirá desde el día siguiente.
			</p>
			<a
				href="/uf/manana"
				class="inline-flex px-4 py-2 rounded-xl text-sm font-semibold text-slate-200 bg-slate-900/50 border border-slate-800 hover:border-blue-500/50 hover:text-blue-400 transition-colors"
			>
				Ver UF mañana
			</a>
		</section>

		<Card className="p-6 bg-slate-900/50 border-slate-800">
			<h2 class="text-xl font-bold text-white mb-2">¿Cómo se calcula el valor de la UF?</h2>
			<p class="leading-relaxed">
				La UF se reajusta diariamente según la variación del IPC del mes anterior. El Banco Central de Chile
				publica la tabla mensual con todos los días del calendario, incluidos fines de semana y feriados.
			</p>
			<p class="mt-3 text-sm text-slate-400">
				Fuente: Banco Central de Chile, replicada por
				<a href="https://mindicador.cl/uf" target="_blank" rel="noopener noreferrer" class="underline hover:text-blue-400 transition-colors">mindicador.cl</a>.
			</p>
		</Card>
	</main>
</Layout>
