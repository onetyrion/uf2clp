---
import Layout from '../../layouts/Layout.astro';
import { Card } from '../../components/atoms/Card';
import { fetchUFByDate } from '../../lib/uf';
import { formatUfDate, getTodayISO } from '../../lib/date';
import { UF_YEARS } from '../../data/uf-years';

const todayISO = getTodayISO();

const tomorrow = new Date(`${todayISO}T00:00:00Z`);
tomorrow.setUTCDate(tomorrow.getUTCDate() + 1);
const tomorrowISO = tomorrow.toISOString().slice(0, 10);
const year = Number(tomorrowISO.slice(0, 4));
const data = await fetchUFByDate(tomorrowISO);

const historyYear = UF_YEARS.includes(year) ? year : Math.max(...UF_YEARS);

const clpFormatter = new Intl.NumberFormat('es-CL', {
	style: 'currency',
	currency: 'CLP',
	minimumFractionDigits: 2,
	maximumFractionDigits: 2,
});

const breadcrumb = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://uf2clp.cl/' },
		{ '@type': 'ListItem', position: 2, name: 'Valor UF mañana', item: 'https://uf2clp.cl/uf/manana' },
	],
};
---

<Layout
	title={`Valor UF mañana | ${formatUfDate(tomorrowISO)}`}
	description={`Valor publicado de la UF para mañana, ${formatUfDate(tomorrowISO)}. Consulta el monto en pesos y el historial de la UF.`}
	jsonLd={breadcrumb}
>
	<main class="max-w-3xl mx-auto px-6 pt-10 pb-20 space-y-8 text-slate-400">
		<nav class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
			<a href="/" class="font-semibold text-slate-300 hover:text-blue-400 transition-colors">Inicio</a>
			<span class="text-slate-600">/</span>
			<span class="font-semibold text-slate-400">UF mañana</span>
		</nav>

		<header class="space-y-3">
			<p class="text-sm font-semibold uppercase tracking-[0.2em] text-blue-400">Valor publicado</p>
			<h1 class="text-3xl md:text-4xl font-extrabold text-white tracking-tight">Valor de la UF mañana</h1>
			<p class="leading-relaxed">
				El Banco Central de Chile publica los valores de la UF con anticipación. Este es el valor
				correspondiente al <strong class="text-slate-200 capitalize">{formatUfDate(tomorrowISO)}</strong>.
			</p>
		</header>

		{data ? (
			<Card className="p-8 bg-slate-900/50 border-slate-800 text-center">
				<p class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-3">1 UF =</p>
				<p class="text-4xl md:text-5xl font-extrabold text-white tabular-nums">{clpFormatter.format(data.valor)}</p>
				<p class="mt-3 text-sm text-slate-400 capitalize">Vigente el {formatUfDate(data.fecha)}</p>
			</Card>
		) : (
			<Card className="p-6 bg-slate-900/50 border-slate-800">
				<p class="text-slate-300">
					El valor de la UF para mañana todavía no está disponible. Vuelve más tarde o revisa el
					valor vigente de hoy.
				</p>
			</Card>
		)}

		<div class="flex flex-wrap gap-3">
			<a
				href="/"
				class="px-4 py-2 rounded-xl text-sm font-semibold text-white bg-blue-600 hover:bg-blue-500 transition-colors"
			>
				Ver valor de hoy
			</a>
			<a
				href={`/uf/${historyYear}`}
				class="px-4 py-2 rounded-xl text-sm font-semibold text-slate-200 bg-slate-900/50 border border-slate-800 hover:border-blue-500/50 hover:text-blue-400 transition-colors"
			>
				Historial {historyYear}
			</a>
			<a
				href="/uf"
				class="px-4 py-2 rounded-xl text-sm font-semibold text-slate-200 bg-slate-900/50 border border-slate-800 hover:border-blue-500/50 hover:text-blue-400 transition-colors"
			>
				Historial completo
			</a>
			<a
				href="/#calculadora"
				class="px-4 py-2 rounded-xl text-sm font-semibold text-slate-200 bg-slate-900/50 border border-slate-800 hover:border-blue-500/50 hover:text-blue-400 transition-colors"
			>
				Calculadora
			</a>
		</div>

		<Card className="p-6 bg-slate-900/50 border-slate-800">
			<h2 class="text-xl font-bold text-white mb-2">¿Cómo se obtiene este valor?</h2>
			<p class="leading-relaxed">
				La UF se reajusta diariamente según la variación del IPC del mes anterior. El Banco Central
				publica la tabla mensual con todos los días del calendario, por lo que el valor de mañana ya
				está definido antes de que comience el día.
			</p>
			<p class="mt-3 text-sm text-slate-400">
				Fuente: Banco Central de Chile, replicada por
				<a href="https://mindicador.cl/uf" target="_blank" rel="noopener noreferrer" class="underline hover:text-blue-400 transition-colors">mindicador.cl</a>.
				Verifica siempre el valor oficial antes de cerrar una operación.
			</p>
		</Card>
	</main>
</Layout>
