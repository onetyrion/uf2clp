---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../components/organisms/Navbar';
import { Dashboard } from '../components/templates/Dashboard';
import { ContentSection } from '../components/organisms/ContentSection';
import { PWAInstallGuide } from '../components/molecules/PWAInstallGuide';
import { fetchCurrentUF } from '../lib/uf';
import { FAQ_ITEMS } from '../data/faq';

const initialUF = await fetchCurrentUF();
const buildCommit = import.meta.env.PUBLIC_BUILD_COMMIT;
const buildBranch = import.meta.env.PUBLIC_BUILD_BRANCH;
const buildTime = import.meta.env.PUBLIC_BUILD_TIME;

const faqJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: FAQ_ITEMS.map((item) => ({
		'@type': 'Question',
		name: item.question,
		acceptedAnswer: {
			'@type': 'Answer',
			text: item.answer,
		},
	})),
};
---

<Layout
	title="Calculadora UF a CLP | Valor UF Hoy en Chile | uf2clp.cl"
	jsonLd={faqJsonLd}
>
	<Navbar client:load />
	<Dashboard client:load initialUF={initialUF} />
    <PWAInstallGuide client:only="react" />
    <ContentSection />
	<footer class="text-center py-10 text-sm flex flex-col items-center justify-center gap-2">
		<div class="opacity-60 hover:opacity-100 transition-opacity duration-300">
			<a href="https://github.com/onetyrion" target="_blank" rel="noopener noreferrer" class="hover:text-blue-500 transition-colors">
				Creado por @onetyrion
			</a>
			<span class="mx-2">&bull;</span>
			2025
		</div>
		<div class="flex gap-4 mt-2 opacity-60 hover:opacity-100 transition-opacity duration-300">
			<a href="https://www.iubenda.com/privacy-policy/67905716" class="iubenda-white iubenda-noiframe iubenda-embed hover:text-blue-500 transition-colors" title="Política de Privacidad ">Política de Privacidad</a><script type="text/javascript" is:inline>(function (w,d) {var loader = function () {var s = d.createElement("script"), tag = d.getElementsByTagName("script")[0]; s.src="https://cdn.iubenda.com/iubenda.js"; tag.parentNode.insertBefore(s,tag);}; if(w.addEventListener){w.addEventListener("load", loader, false);}else if(w.attachEvent){w.attachEvent("onload", loader);}else{w.onload = loader;}})(window, document);</script>
			<a href="https://www.iubenda.com/privacy-policy/67905716/cookie-policy" class="iubenda-white iubenda-noiframe iubenda-embed hover:text-blue-500 transition-colors" title="Política de Cookies ">Política de Cookies</a><script type="text/javascript" is:inline>(function (w,d) {var loader = function () {var s = d.createElement("script"), tag = d.getElementsByTagName("script")[0]; s.src="https://cdn.iubenda.com/iubenda.js"; tag.parentNode.insertBefore(s,tag);}; if(w.addEventListener){w.addEventListener("load", loader, false);}else if(w.attachEvent){w.attachEvent("onload", loader);}else{w.onload = loader;}})(window, document);</script>
		</div>
		<div class="mt-1 font-mono text-xs text-slate-400" title={`Rama ${buildBranch} · commit ${buildCommit}`}>
			build {buildCommit} · {buildTime}
		</div>
	</footer>
</Layout>
