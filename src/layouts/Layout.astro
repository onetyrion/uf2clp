---
import "../styles/global.css";
import { FinanceBackground } from "../components/atoms/FinanceBackground";
import ConsentBanner from "../components/molecules/ConsentBanner.astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, image = "/og-image.jpg", jsonLd } = Astro.props;
const metaDescription = description ??
  "Calculadora de UF a CLP actualizada al instante. Conversor simple, rápido y preciso del valor de la UF hoy en Chile. Gráficos históricos y tendencias.";
const socialDescription = description ??
  "Calculadora de UF a CLP actualizada al instante. Conversor simple, rápido y preciso del valor de la UF hoy en Chile.";

const baseUrl = Astro.site ?? new URL("https://uf2clp.cl");
const canonical = new URL(Astro.url.pathname, baseUrl);
const ogImage = new URL(image, baseUrl).toString();
const pageJsonLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

const webApplicationLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "UF2CLP",
  url: "https://uf2clp.cl",
  description: "Calculadora y conversor de UF a Peso Chileno con datos actualizados diariamente.",
  applicationCategory: "FinanceApplication",
  operatingSystem: "Web",
  inLanguage: "es-CL",
  isAccessibleForFree: true,
  dateModified: import.meta.env.PUBLIC_BUILD_DATE,
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "CLP",
  },
};

const websiteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "UF2CLP",
  url: "https://uf2clp.cl/",
  inLanguage: "es-CL",
  publisher: {
    "@type": "Organization",
    name: "UF2CLP",
    url: "https://uf2clp.cl/",
    logo: new URL("/icons/icon-512.png", baseUrl).toString(),
  },
};
---

<!doctype html>
<html lang="es" class="scroll-smooth dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="mask-icon" href="/favicon.svg" color="#2563eb" />
    <meta name="theme-color" content="#0f172a" />
    <meta name="build-version" content={`${import.meta.env.PUBLIC_BUILD_COMMIT} · ${import.meta.env.PUBLIC_BUILD_TIME}`} />
    <meta name="build-branch" content={import.meta.env.PUBLIC_BUILD_BRANCH} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Primary Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={metaDescription} />
    <meta
      name="keywords"
      content="calculadora uf, uf2clp, valor uf hoy, uf a pesos, conversor uf, indicadores economicos chile, unidad de fomento"
    />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:site_name" content="UF2CLP" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="UF2CLP: calculadora de UF a CLP y valor UF hoy en Chile" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonical} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={socialDescription} />
    <meta property="twitter:image" content={ogImage} />
    <meta property="twitter:image:alt" content="UF2CLP: calculadora de UF a CLP y valor UF hoy en Chile" />

    <link rel="preload" href="/fonts/inter-latin-var.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(webApplicationLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteLd)} />
    {pageJsonLd.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}

    <script is:inline>
      // Force dark mode
      document.documentElement.classList.add("dark");
      if (typeof localStorage !== "undefined") {
        localStorage.setItem("theme", "dark");
      }
    </script>
    <script src="/src/analytics.ts"></script>
    <script src="/src/pwa.ts"></script>
  </head>
  <body
    class="transition-colors duration-500 bg-slate-100 dark:bg-gradient-to-br dark:from-slate-950 dark:to-slate-900 min-h-screen text-slate-900 dark:text-white font-sans"
  >
    <FinanceBackground client:only="react" />
    <slot />
    <ConsentBanner />
  </body>
</html>
